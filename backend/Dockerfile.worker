# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git

ENV GOPROXY=https://goproxy.cn,direct

COPY go.mod go.sum ./
COPY third_party ./third_party
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o worker ./cmd/worker

# Runtime stage
FROM alpine:latest

# KEEP IN SYNC WITH backend/Dockerfile runtime packages.
# poppler-utils + tesseract are required by cmd/worker/pdf_ocr.go for
# scanned-PDF OCR; without them every queued OCR article fails with
# "exec: pdftoppm: not found" and gets stranded in 'failed' state.
# Tencent deployment keeps Alpine signature verification with a nearby mirror.
# Override for builds elsewhere: --build-arg ALPINE_MIRROR=dl-cdn.alpinelinux.org
ARG ALPINE_MIRROR=mirrors.cloud.tencent.com
RUN sed -i "s@https://dl-cdn.alpinelinux.org/alpine@https://${ALPINE_MIRROR}/alpine@g" /etc/apk/repositories \
    && apk --no-cache add ca-certificates tzdata \
    yt-dlp \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-data-eng \
    tesseract-ocr-data-chi_sim

WORKDIR /app

COPY --from=builder /app/worker .

CMD ["./worker"]
