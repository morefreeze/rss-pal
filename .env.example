# AI service (OpenAI-compatible endpoint, e.g. z.ai, OpenAI, etc.)
CLAUDE_API_KEY=your_api_key_here
CLAUDE_BASE_URL=https://api.openai.com/v1
CLAUDE_MODEL=glm-5.3

# Admin password for first login
AUTH_PASSWORD=change_me

# JWT secret — change this in production to a long random string
JWT_SECRET=change_me_to_random_string

# Share-token secret — keep separate from JWT_SECRET
SHARE_SECRET=change_me_to_a_separate_32_byte_random_string

# Canonical public origin for permanent short share links (no trailing slash)
SHORT_SHARE_ORIGIN=https://r.morefreeze.top

# Jina Reader API key (optional) — used as a fallback for pages blocked by
# Cloudflare/anti-bot or that render content via JS. Get one at https://jina.ai
JINA_API_KEY=

# Z.ai Web Reader MCP (optional) — first fallback for server-side article
# extraction. Create a dedicated key for Reader; do not reuse CLAUDE_API_KEY.
# Leave the URL empty to use https://api.z.ai/api/mcp/web_reader/mcp.
ZAI_READER_API_KEY=
ZAI_READER_MCP_URL=

# Subscription Explore queue: 500 is the hard global task-throughput cap for
# each logical fetch window, not a per-process or per-concurrency quota.
# Concurrency 5 is the number of real network fetches allowed in parallel.
# Batch limit accepts 1..500; concurrency must be a positive integer.
EXPLORE_FETCH_BATCH_LIMIT=500
EXPLORE_FETCH_CONCURRENCY=5

# Bilibili cookie (optional) — needed for B 站 user/video RSS routes. Open
# bilibili.com while logged in, DevTools → Application → Cookies → copy the
# full cookie string and paste it here as ONE LINE (no quotes).
BILIBILI_COOKIE=

# Public registration: server-side Tencent Captcha 2.0 verification (missing keys fail closed).
AUTH_CAPTCHA_PROVIDER=tencent
TENCENT_CAPTCHA_APP_ID=
TENCENT_CAPTCHA_APP_SECRET=
TENCENT_CAPTCHA_SECRET_ID=
TENCENT_CAPTCHA_SECRET_KEY=
# Fixed account IDs, not all administrators. Empty list denies share-based signup.
SHARE_REGISTRATION_MODE=selected_owners
SHARE_REGISTRATION_OWNER_IDS=

# Admin operations monitoring. Counts are attempts, not tokens or provider bills.
# Fault/limit alerts use a rolling 15-minute window. Queue age is a live snapshot.
OPS_MONITOR_CAPTCHA_MIN_FAILURES=3
OPS_MONITOR_CAPTCHA_FAILURE_RATIO=0.2
OPS_MONITOR_LIMIT_THRESHOLD=20
OPS_MONITOR_QUEUE_WAIT_SECONDS=1800
OPS_MONITOR_QUOTA_WARNING_RATIO=0.8
# Optional positive CNY daily estimate threshold and per-task estimated prices.
# Example: OPS_MONITOR_UNIT_PRICES={"ai":0.01,"fetch":0.001}
# Unpriced task types remain explicitly unpriced and are not included in estimates.
OPS_MONITOR_DAILY_COST_BUDGET=
OPS_MONITOR_UNIT_PRICES=
# Optional RFC3339 package expiry, e.g. 2026-09-23T00:00:00+08:00.
# This is operator configuration, not a Tencent balance API.
OPS_MONITOR_CAPTCHA_EXPIRES_AT=

# 管理员后台抓取每日额度；普通用户默认 500，全站每日 5000，按 UTC 重置。
TASK_BACKGROUND_FETCH_ADMIN_DAILY=2000
